{
  "name": "agent-setup",
  "version": "0.1.0",
  "description": "TypeScript CLI that installs, updates, diagnoses, configures, and removes a coding-agent setup: skills, guard hooks, agent configuration, workflow templates, and status lines for Claude Code, Codex, Grok, Kimi, Kiro, and more.",
  "type": "module",
  "bin": {
    "agent-setup": "dist/src/cli/main.js"
  },
  "imports": {
    "#src/*": {
      "source": "./src/*",
      "default": "./dist/src/*"
    }
  },
  "files": [
    "dist",
    "src/skills",
    "src/templates",
    "README.md",
    "LICENSE",
    "!src/skills/**/node_modules",
    "!src/skills/**/node_modules/**",
    "!dist/src/scripts"
  ],
  "scripts": {
    "dev": "tsx watch --conditions=source src/cli/main.ts",
    "prod": "pnpm build && node dist/src/cli/main.js",
    "prepare": "husky",
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc --project tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/src/cli/main.js',0o755)\"",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/agent-setup.tsbuildinfo",
    "lint": "biome check . && knip",
    "lint:fix": "biome check --write .",
    "readme:generate": "tsx --conditions=source src/scripts/generate-readme.ts",
    "readme:check": "tsx --conditions=source src/scripts/generate-readme.ts --check",
    "check": "turbo run lint typecheck test build readme:check --output-logs=errors-only"
  },
  "keywords": [
    "claude-code",
    "claude",
    "codex",
    "grok",
    "skills",
    "hooks",
    "cli",
    "context-window",
    "handoff",
    "autonomous",
    "agent",
    "ai",
    "developer-tools",
    "macos",
    "svg",
    "image-to-code"
  ],
  "author": "Yosef Hayim Sabag",
  "license": "MIT",
  "homepage": "https://github.com/YosefHayim/agent-setup#readme",
  "bugs": {
    "url": "https://github.com/YosefHayim/agent-setup/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YosefHayim/agent-setup.git"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.18.0",
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "commander": "15.1.0",
    "jsonc-parser": "3.3.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "glob": "14.0.4",
    "husky": "9.1.7",
    "knip": "6.44.2",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
